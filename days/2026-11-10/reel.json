{
  "version": 3,
  "settings": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "safe_area": "reels"
  },
  "brand": {
    "from": "assets/key.png",
    "primary": "#e0245e",
    "secondary": "#12141c",
    "text": "#ffffff"
  },
  "copy": "copy.json",
  "audio": {
    "music": "assets/music.mp3",
    "snap_cuts_to_beats": true,
    "voiceover": false,
    "music_gain_db": -10
  },
  "shots": [
    {
      "id": "hook",
      "source": {
        "video": "assets/metal/metal-chrome.mp4",
        "loop": true
      },
      "duration": "beats:6",
      "motion": {
        "type": "none"
      },
      "caption": {
        "copy_id": "hook",
        "style": "auto-box",
        "reveal": "typewriter",
        "anchor": "auto"
      }
    },
    {
      "id": "gold",
      "source": {
        "video": "assets/metal/metal-gold.mp4",
        "loop": true
      },
      "duration": "beats:6",
      "transition_in": "auto",
      "motion": {
        "type": "none"
      },
      "caption": {
        "copy_id": "p1",
        "style": "auto-box",
        "reveal": "typewriter",
        "anchor": "auto"
      }
    },
    {
      "id": "mercury",
      "source": {
        "video": "assets/metal/metal-mercury.mp4",
        "loop": true
      },
      "duration": "beats:4",
      "transition_in": "auto",
      "motion": {
        "type": "none"
      }
    },
    {
      "id": "palettes",
      "source": {
        "image": "assets/card-metal-palettes.png"
      },
      "duration": "beats:8",
      "transition_in": "auto",
      "motion": {
        "type": "frame",
        "from": [
          0,
          0,
          1,
          1
        ],
        "to": [
          0.02,
          0.04,
          0.96,
          0.96
        ],
        "at": [
          0.05,
          0.9
        ],
        "ease": "out"
      },
      "caption": {
        "copy_id": "p2",
        "style": "auto-box",
        "reveal": "typewriter",
        "anchor": "bottom"
      }
    },
    {
      "id": "iridescent",
      "source": {
        "video": "assets/metal/metal-iridescent.mp4",
        "loop": true
      },
      "duration": "beats:7",
      "transition_in": "auto",
      "motion": {
        "type": "none"
      },
      "caption": {
        "copy_id": "p3",
        "style": "auto-box",
        "reveal": "typewriter",
        "anchor": "auto"
      }
    }
  ],
  "end_card": {
    "template": "brand-split",
    "duration": 3.5,
    "audio": "keep",
    "copy": {
      "headline": "end_head",
      "sub": "end_sub",
      "url": "url"
    },
    "headline_reveal": "typewriter"
  }
}