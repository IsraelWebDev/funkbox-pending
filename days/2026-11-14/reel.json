{
 "version": 3,
 "settings": {
  "width": 1080,
  "height": 1920,
  "fps": 30,
  "safe_area": "reels"
 },
 "brand": {
  "from": "assets/key.png",
  "primary": "#ffd23f",
  "secondary": "#0a0a0f",
  "text": "#ffffff"
 },
 "copy": "copy.json",
 "audio": {
  "music": "assets/music.mp3",
  "snap_cuts_to_beats": true,
  "voiceover": false,
  "music_gain_db": -10
 },
 "shots": [
  {
   "id": "poster",
   "source": {
    "image": "assets/poster/sale.png"
   },
   "duration": "beats:7",
   "motion": {
    "type": "none"
   },
   "caption": {
    "copy_id": "hook",
    "style": "auto-box",
    "reveal": "typewriter",
    "anchor": "bottom"
   }
  },
  {
   "id": "audit",
   "source": {
    "image": "assets/card-text-exact.png"
   },
   "duration": "beats:6",
   "transition_in": "auto",
   "motion": {
    "type": "frame",
    "from": [
     0,
     0,
     1,
     1
    ],
    "to": [
     0.0,
     0.03,
     0.72,
     0.72
    ],
    "at": [
     0.05,
     0.85
    ],
    "ease": "out"
   },
   "caption": {
    "copy_id": "p1",
    "style": "auto-box",
    "reveal": "typewriter",
    "anchor": "bottom"
   }
  },
  {
   "id": "zoom-png",
   "source": {
    "image": "assets/zoom-png.png"
   },
   "duration": "beats:5",
   "transition_in": "auto",
   "motion": {
    "type": "none"
   },
   "caption": {
    "copy_id": "p2",
    "style": "auto-box",
    "reveal": "typewriter",
    "anchor": "bottom"
   }
  },
  {
   "id": "zoom-pdf",
   "source": {
    "image": "assets/zoom-pdf.png"
   },
   "duration": "beats:6",
   "transition_in": "auto",
   "motion": {
    "type": "none"
   },
   "caption": {
    "copy_id": "p3",
    "style": "auto-box",
    "reveal": "typewriter",
    "anchor": "bottom"
   }
  },
  {
   "id": "formats",
   "source": {
    "image": "assets/poster/sale.png"
   },
   "duration": "beats:6",
   "transition_in": "auto",
   "motion": {
    "type": "none"
   },
   "caption": {
    "copy_id": "p4",
    "style": "auto-box",
    "reveal": "typewriter",
    "anchor": "bottom"
   }
  }
 ],
 "end_card": {
  "template": "brand-split",
  "duration": 3.5,
  "audio": "keep",
  "copy": {
   "headline": "end_head",
   "sub": "end_sub",
   "url": "url"
  },
  "headline_reveal": "typewriter"
 }
}