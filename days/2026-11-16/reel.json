{
  "version": 3,
  "settings": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "safe_area": "reels"
  },
  "brand": {
    "from": "assets/key.png",
    "primary": "#e0245e",
    "secondary": "#12141c",
    "text": "#ffffff"
  },
  "copy": "copy.json",
  "audio": {
    "music": "assets/music.mp3",
    "snap_cuts_to_beats": true,
    "voiceover": false,
    "music_gain_db": -10
  },
  "shots": [
    {
      "id": "hook",
      "source": {
        "video": "assets/loop-hypno-tunnel.mp4",
        "loop": true
      },
      "duration": "beats:6",
      "motion": {
        "type": "none"
      },
      "caption": {
        "copy_id": "hook",
        "style": "auto-box",
        "reveal": "typewriter",
        "anchor": "auto"
      }
    },
    {
      "id": "song",
      "source": {
        "video": "assets/loop-pop-moire.mp4",
        "loop": true
      },
      "duration": "beats:6",
      "motion": {
        "type": "none"
      },
      "caption": {
        "copy_id": "p1",
        "style": "auto-box",
        "reveal": "typewriter",
        "anchor": "auto"
      }
    },
    {
      "id": "beats",
      "source": {
        "image": "assets/card-frame-json.png"
      },
      "duration": "beats:10",
      "motion": {
        "type": "frame",
        "from": [
          0.0,
          0.0,
          1.0,
          1.0
        ],
        "to": [
          0.015,
          0.0,
          0.96,
          0.96
        ],
        "at": [
          0.05,
          0.9
        ],
        "ease": "out"
      },
      "caption": {
        "copy_id": "p2",
        "style": "auto-box",
        "reveal": "typewriter",
        "anchor": "bottom"
      }
    },
    {
      "id": "render",
      "source": {
        "video": "assets/loop-pop-moire.mp4",
        "loop": true
      },
      "duration": "beats:6",
      "motion": {
        "type": "none"
      },
      "caption": {
        "copy_id": "p3",
        "style": "auto-box",
        "reveal": "typewriter",
        "anchor": "auto"
      }
    },
    {
      "id": "cut1",
      "source": {
        "image": "assets/scene-dog.jpg"
      },
      "duration": "beats:2",
      "motion": {
        "type": "none"
      }
    },
    {
      "id": "cut2",
      "source": {
        "image": "assets/scene-machine.jpg"
      },
      "duration": "beats:2",
      "motion": {
        "type": "none"
      }
    },
    {
      "id": "cut3",
      "source": {
        "video": "assets/loop-hypno-tunnel.mp4",
        "loop": true
      },
      "duration": "beats:2",
      "motion": {
        "type": "none"
      }
    },
    {
      "id": "local",
      "source": {
        "video": "assets/loop-pop-moire.mp4",
        "loop": true
      },
      "duration": "beats:6",
      "motion": {
        "type": "none"
      },
      "caption": {
        "copy_id": "p4",
        "style": "auto-box",
        "reveal": "typewriter",
        "anchor": "auto"
      }
    }
  ],
  "end_card": {
    "template": "brand-split",
    "duration": 3.5,
    "audio": "keep",
    "copy": {
      "headline": "end_head",
      "sub": "end_sub",
      "url": "url"
    },
    "headline_reveal": "typewriter"
  }
}