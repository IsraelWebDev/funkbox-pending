{
  "version": 3,
  "settings": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "safe_area": "reels"
  },
  "brand": {
    "from": "assets/key.png",
    "primary": "#e0245e",
    "secondary": "#12141c",
    "text": "#ffffff"
  },
  "copy": "copy.json",
  "audio": {
    "music": "assets/music.mp3",
    "snap_cuts_to_beats": true,
    "voiceover": false,
    "music_gain_db": -10
  },
  "shots": [
    {
      "id": "hook",
      "source": {
        "video": "assets/demo-ad.mp4",
        "trim": [
          3.6,
          7.0
        ]
      },
      "duration": "beats:6",
      "motion": {
        "type": "frame",
        "from": [
          0.3,
          0.32,
          0.6,
          0.6
        ],
        "to": [
          0.42,
          0.45,
          0.42,
          0.42
        ],
        "at": [
          0.05,
          0.85
        ],
        "ease": "out"
      },
      "caption": {
        "copy_id": "hook",
        "style": "auto-box",
        "reveal": "typewriter",
        "anchor": "top"
      }
    },
    {
      "id": "wide",
      "source": {
        "video": "assets/formats/glowmop-16x9.mp4",
        "trim": [
          12.8,
          17.4
        ],
        "fit": "contain",
        "pad": "#12141c"
      },
      "duration": "beats:8",
      "transition_in": "auto",
      "motion": {
        "type": "none"
      },
      "caption": {
        "copy_id": "p1",
        "style": "auto-box",
        "reveal": "typewriter",
        "anchor": "top"
      }
    },
    {
      "id": "square",
      "source": {
        "video": "assets/formats/glowmop-1x1.mp4",
        "trim": [
          7.2,
          11.8
        ],
        "fit": "contain",
        "pad": "#12141c"
      },
      "duration": "beats:8",
      "transition_in": "auto",
      "motion": {
        "type": "none"
      },
      "caption": {
        "copy_id": "p2",
        "style": "auto-box",
        "reveal": "typewriter",
        "anchor": "top"
      }
    },
    {
      "id": "portrait",
      "source": {
        "video": "assets/formats/glowmop-4x5.mp4",
        "trim": [
          12.95,
          17.4
        ],
        "fit": "contain",
        "pad": "#12141c"
      },
      "duration": "beats:8",
      "transition_in": "auto",
      "motion": {
        "type": "none"
      },
      "caption": {
        "copy_id": "p3",
        "style": "auto-box",
        "reveal": "typewriter",
        "anchor": "top"
      }
    }
  ],
  "end_card": {
    "template": "brand-split",
    "duration": 3.5,
    "audio": "keep",
    "copy": {
      "headline": "end_head",
      "sub": "end_sub",
      "url": "url"
    },
    "headline_reveal": "typewriter"
  }
}