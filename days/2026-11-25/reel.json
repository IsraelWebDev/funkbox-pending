{
  "version": 3,
  "settings": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "safe_area": "reels"
  },
  "brand": {
    "from": "assets/key.png",
    "primary": "#e0245e",
    "secondary": "#12141c",
    "text": "#ffffff"
  },
  "copy": "copy.json",
  "audio": {
    "music": "assets/music.mp3",
    "snap_cuts_to_beats": true,
    "voiceover": false,
    "music_gain_db": -10
  },
  "shots": [
    {
      "id": "wide",
      "source": {
        "video": "assets/screen.mp4",
        "trim": [
          1.8,
          5.6
        ],
        "fit": "contain",
        "pad": "#0f1117"
      },
      "duration": "beats:5",
      "motion": {
        "type": "none"
      },
      "caption": {
        "copy_id": "hook",
        "style": "auto-box",
        "reveal": "typewriter",
        "anchor": "bottom"
      }
    },
    {
      "id": "push",
      "source": {
        "video": "assets/screen.mp4",
        "trim": [
          5.6,
          10.2
        ]
      },
      "duration": "beats:6",
      "transition_in": "auto",
      "motion": {
        "type": "frame",
        "from": [
          0.0,
          0.0,
          0.316,
          1.0
        ],
        "to": [
          0.021,
          0.037,
          0.292,
          0.716
        ],
        "at": [
          0.0,
          0.55
        ],
        "ease": "out"
      },
      "caption": {
        "copy_id": "p1",
        "style": "auto-box",
        "reveal": "typewriter",
        "anchor": "bottom"
      }
    },
    {
      "id": "line",
      "source": {
        "image": "assets/card-frame-json.png"
      },
      "duration": "beats:6",
      "transition_in": "auto",
      "motion": {
        "type": "frame",
        "from": [
          0,
          0,
          1,
          1
        ],
        "to": [
          0.02,
          0.08,
          0.96,
          0.17
        ],
        "at": [
          0.05,
          0.7
        ],
        "ease": "out"
      },
      "caption": {
        "copy_id": "p2",
        "style": "auto-box",
        "reveal": "typewriter",
        "anchor": "bottom"
      }
    },
    {
      "id": "same",
      "source": {
        "video": "assets/screen.mp4",
        "trim": [
          8.2,
          11.95
        ],
        "focus": [
          0.17,
          0.4
        ]
      },
      "duration": "beats:5",
      "transition_in": "auto",
      "motion": {
        "type": "none"
      },
      "caption": {
        "copy_id": "p3",
        "style": "auto-box",
        "reveal": "typewriter",
        "anchor": "bottom"
      }
    }
  ],
  "end_card": {
    "template": "brand-split",
    "duration": 3.5,
    "audio": "keep",
    "copy": {
      "headline": "end_head",
      "sub": "end_sub",
      "url": "url"
    },
    "headline_reveal": "typewriter"
  }
}