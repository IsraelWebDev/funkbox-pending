{
  "version": 3,
  "settings": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "safe_area": "reels"
  },
  "brand": {
    "from": "assets/key.png",
    "primary": "#e0245e",
    "secondary": "#12141c",
    "text": "#ffffff"
  },
  "copy": "copy.json",
  "audio": {
    "music": "assets/music.mp3",
    "snap_cuts_to_beats": true,
    "voiceover": false,
    "music_gain_db": -10
  },
  "shots": [
    {
      "id": "hook",
      "source": {
        "video": "assets/loop-party-poster.mp4",
        "loop": true
      },
      "duration": "beats:5",
      "motion": {
        "type": "none"
      },
      "caption": {
        "copy_id": "hook",
        "style": "auto-box",
        "reveal": "typewriter",
        "anchor": "auto"
      }
    },
    {
      "id": "cut1",
      "source": {
        "image": "assets/scene-dog.jpg"
      },
      "duration": "beats:2",
      "transition_in": "auto",
      "motion": {
        "type": "kenburns",
        "zoom": [
          1.0,
          1.12
        ],
        "pan": [
          [
            0,
            0
          ],
          [
            0.02,
            -0.03
          ]
        ]
      }
    },
    {
      "id": "cut2",
      "source": {
        "image": "assets/scene-machine.jpg"
      },
      "duration": "beats:2",
      "transition_in": "auto",
      "motion": {
        "type": "kenburns",
        "zoom": [
          1.0,
          1.12
        ],
        "pan": [
          [
            0,
            0
          ],
          [
            0.02,
            -0.03
          ]
        ]
      }
    },
    {
      "id": "cut3",
      "source": {
        "video": "assets/loop-hypno-tunnel.mp4",
        "loop": true
      },
      "duration": "beats:2",
      "transition_in": "auto",
      "motion": {
        "type": "none"
      }
    },
    {
      "id": "grid",
      "source": {
        "video": "assets/loop-hypno-tunnel.mp4",
        "loop": true
      },
      "duration": "beats:6",
      "transition_in": "auto",
      "motion": {
        "type": "none"
      },
      "caption": {
        "copy_id": "p1",
        "style": "auto-box",
        "reveal": "typewriter",
        "anchor": "auto"
      }
    },
    {
      "id": "within",
      "source": {
        "image": "assets/scene-machine.jpg"
      },
      "duration": "beats:6",
      "transition_in": "auto",
      "motion": {
        "type": "kenburns",
        "zoom": [
          1.0,
          1.12
        ],
        "pan": [
          [
            0,
            0
          ],
          [
            0.02,
            -0.03
          ]
        ]
      },
      "caption": {
        "copy_id": "p2",
        "style": "auto-box",
        "reveal": "typewriter",
        "anchor": "bottom"
      }
    },
    {
      "id": "demo",
      "source": {
        "video": "assets/demo-ad.mp4",
        "trim": [
          0.2,
          2.4
        ]
      },
      "duration": "beats:4",
      "transition_in": "auto",
      "motion": {
        "type": "frame",
        "from": [
          0,
          0,
          1,
          1
        ],
        "to": [
          0.1,
          0.15,
          0.8,
          0.8
        ],
        "at": [
          0.05,
          0.9
        ],
        "ease": "out"
      }
    },
    {
      "id": "render",
      "source": {
        "video": "assets/loop-party-poster.mp4",
        "loop": true
      },
      "duration": "beats:6",
      "transition_in": "auto",
      "motion": {
        "type": "none"
      },
      "caption": {
        "copy_id": "p3",
        "style": "auto-box",
        "reveal": "typewriter",
        "anchor": "auto"
      }
    },
    {
      "id": "audit",
      "source": {
        "image": "assets/card-text-exact.png"
      },
      "duration": "beats:6",
      "transition_in": "auto",
      "motion": {
        "type": "frame",
        "from": [
          0,
          0,
          1,
          1
        ],
        "to": [
          0.0,
          0.0,
          0.92,
          0.92
        ],
        "at": [
          0.05,
          0.9
        ],
        "ease": "out"
      },
      "caption": {
        "copy_id": "p4",
        "style": "auto-box",
        "reveal": "typewriter",
        "anchor": "bottom"
      }
    }
  ],
  "end_card": {
    "template": "brand-split",
    "duration": 3.5,
    "audio": "keep",
    "copy": {
      "headline": "end_head",
      "sub": "end_sub",
      "url": "url"
    },
    "headline_reveal": "typewriter"
  }
}