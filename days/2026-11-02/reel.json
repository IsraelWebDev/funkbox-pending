{
  "version": 3,
  "settings": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "safe_area": "reels"
  },
  "brand": {
    "primary": "#e0245e",
    "secondary": "#12141c",
    "text": "#ffffff"
  },
  "copy": "copy.json",
  "audio": {
    "music": "assets/music.mp3",
    "bpm": 110,
    "snap_cuts_to_beats": true,
    "voiceover": false,
    "music_gain_db": -10
  },
  "shots": [
    {
      "id": "hook",
      "source": {
        "video": "assets/loop-hypno-tunnel.mp4",
        "loop": true
      },
      "duration": "beats:7",
      "motion": {
        "type": "none"
      },
      "caption": {
        "copy_id": "hook",
        "style": "red-box",
        "reveal": "typewriter",
        "anchor": "center"
      }
    },
    {
      "id": "recipe",
      "source": {
        "image": "assets/card-loop-recipe.png"
      },
      "duration": "beats:8",
      "transition_in": "zoom-punch",
      "motion": {
        "type": "frame",
        "from": [
          0.0,
          0.0,
          1.0,
          1.0
        ],
        "to": [
          0.01,
          0.02,
          0.96,
          0.96
        ],
        "at": [
          0.05,
          0.9
        ],
        "ease": "out"
      },
      "caption": {
        "copy_id": "p1",
        "style": "red-box",
        "reveal": "typewriter",
        "anchor": "bottom"
      }
    },
    {
      "id": "loop",
      "source": {
        "video": "assets/loop-pop-moire.mp4",
        "loop": true
      },
      "duration": "beats:8",
      "transition_in": "push",
      "motion": {
        "type": "none"
      },
      "caption": {
        "copy_id": "p2",
        "style": "red-box",
        "reveal": "typewriter",
        "anchor": "center"
      }
    },
    {
      "id": "render",
      "source": {
        "video": "assets/loop-hypno-tunnel.mp4",
        "loop": true
      },
      "duration": "beats:8",
      "transition_in": "flash",
      "motion": {
        "type": "kenburns",
        "zoom": [
          1.0,
          1.25
        ],
        "pan": [
          [
            0,
            0
          ],
          [
            0,
            0
          ]
        ]
      },
      "caption": {
        "copy_id": "p3",
        "style": "red-box",
        "reveal": "typewriter",
        "anchor": "bottom"
      }
    }
  ],
  "end_card": {
    "template": "brand-split",
    "duration": 3.5,
    "audio": "keep",
    "copy": {
      "headline": "end_head",
      "sub": "end_sub",
      "url": "url"
    },
    "headline_reveal": "typewriter"
  }
}