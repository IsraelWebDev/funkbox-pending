{
  "version": 3,
  "settings": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "safe_area": "reels"
  },
  "brand": {
    "from": "assets/key.png",
    "primary": "#e0245e",
    "secondary": "#12141c",
    "text": "#ffffff"
  },
  "copy": "copy.json",
  "audio": {
    "music": "assets/music.mp3",
    "snap_cuts_to_beats": true,
    "voiceover": false,
    "music_gain_db": -10
  },
  "shots": [
    {
      "id": "hook",
      "source": {
        "video": "assets/mask/mask-plasma.mp4",
        "loop": true
      },
      "duration": "beats:8",
      "motion": {
        "type": "none"
      },
      "caption": {
        "copy_id": "hook",
        "style": "auto-box",
        "reveal": "typewriter",
        "anchor": "bottom"
      }
    },
    {
      "id": "card",
      "source": {
        "image": "assets/card-text-mask.png"
      },
      "duration": "beats:8",
      "transition_in": "auto",
      "motion": {
        "type": "frame",
        "from": [
          0,
          0,
          1,
          1
        ],
        "to": [
          0.03,
          0.02,
          0.92,
          0.92
        ],
        "at": [
          0.05,
          0.9
        ],
        "ease": "out"
      },
      "caption": {
        "copy_id": "p1",
        "style": "auto-box",
        "reveal": "typewriter",
        "anchor": "bottom"
      }
    },
    {
      "id": "warp",
      "source": {
        "video": "assets/mask/mask-warp.mp4",
        "loop": true
      },
      "duration": "beats:7",
      "transition_in": "auto",
      "motion": {
        "type": "none"
      },
      "caption": {
        "copy_id": "p2",
        "style": "auto-box",
        "reveal": "typewriter",
        "anchor": "bottom"
      }
    },
    {
      "id": "tunnel",
      "source": {
        "video": "assets/mask/mask-tunnel.mp4",
        "loop": true
      },
      "duration": "beats:7",
      "transition_in": "auto",
      "motion": {
        "type": "none"
      },
      "caption": {
        "copy_id": "p3",
        "style": "auto-box",
        "reveal": "typewriter",
        "anchor": "bottom"
      }
    }
  ],
  "end_card": {
    "template": "brand-split",
    "duration": 3.5,
    "audio": "keep",
    "copy": {
      "headline": "end_head",
      "sub": "end_sub",
      "url": "url"
    },
    "headline_reveal": "typewriter"
  }
}