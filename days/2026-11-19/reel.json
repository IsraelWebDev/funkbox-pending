{
  "version": 3,
  "settings": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "safe_area": "reels"
  },
  "brand": {
    "from": "assets/key.png",
    "primary": "#e0245e",
    "secondary": "#12141c",
    "text": "#ffffff"
  },
  "copy": "copy.json",
  "audio": {
    "music": "assets/music.mp3",
    "snap_cuts_to_beats": true,
    "voiceover": false,
    "music_gain_db": -10
  },
  "shots": [
    {
      "id": "hook",
      "source": {
        "pad": "#12141c",
        "grid": {
          "cols": 2,
          "rows": 2,
          "gap": 0.02,
          "reveal": "sequence",
          "stagger": "beats:0.5",
          "ease": "out",
          "cells": [
            {
              "video": "assets/oneedit/out/dog-16x9.mp4"
            },
            {
              "video": "assets/oneedit/out/dog-1x1.mp4"
            },
            {
              "video": "assets/oneedit/out/dog-4x5.mp4"
            },
            {
              "video": "assets/oneedit/out/dog-9x16.mp4"
            }
          ]
        }
      },
      "duration": "beats:5",
      "motion": {
        "type": "none"
      },
      "caption": {
        "copy_id": "hook",
        "style": "auto-box",
        "reveal": "typewriter",
        "anchor": "center"
      }
    },
    {
      "id": "step1",
      "source": {
        "image": "assets/card-oneedit.png"
      },
      "duration": "beats:5",
      "transition_in": "auto",
      "motion": {
        "type": "none"
      },
      "caption": {
        "copy_id": "p1",
        "style": "auto-box",
        "reveal": "typewriter",
        "anchor": "bottom"
      }
    },
    {
      "id": "step2",
      "source": {
        "image": "assets/card-oneedit.png"
      },
      "duration": "beats:5",
      "transition_in": "auto",
      "motion": {
        "type": "frame",
        "from": [
          0.0,
          0.0,
          1.0,
          1.0
        ],
        "to": [
          0.0,
          0.02,
          0.96,
          0.5
        ],
        "at": [
          0.05,
          0.6
        ],
        "ease": "out"
      },
      "caption": {
        "copy_id": "p2",
        "style": "auto-box",
        "reveal": "typewriter",
        "anchor": "bottom"
      }
    },
    {
      "id": "step3",
      "source": {
        "pad": "#12141c",
        "grid": {
          "cols": 2,
          "rows": 2,
          "gap": 0.02,
          "reveal": "sequence",
          "stagger": "beats:1",
          "ease": "out",
          "cells": [
            {
              "video": "assets/oneedit/out/dog-16x9.mp4"
            },
            {
              "video": "assets/oneedit/out/dog-1x1.mp4"
            },
            {
              "video": "assets/oneedit/out/dog-4x5.mp4"
            },
            {
              "video": "assets/oneedit/out/dog-9x16.mp4"
            }
          ]
        }
      },
      "duration": "beats:7",
      "transition_in": "auto",
      "motion": {
        "type": "none"
      },
      "caption": {
        "copy_id": "p3",
        "style": "auto-box",
        "reveal": "typewriter",
        "anchor": "center"
      }
    },
    {
      "id": "wide",
      "source": {
        "video": "assets/oneedit/out/dog-16x9.mp4",
        "fit": "contain",
        "pad": "blur"
      },
      "duration": "beats:5",
      "transition_in": "auto",
      "motion": {
        "type": "none"
      },
      "caption": {
        "copy_id": "p4",
        "style": "auto-box",
        "reveal": "typewriter",
        "anchor": "bottom"
      }
    }
  ],
  "end_card": {
    "template": "brand-split",
    "duration": 3.5,
    "audio": "keep",
    "copy": {
      "headline": "end_head",
      "sub": "end_sub",
      "url": "url"
    },
    "headline_reveal": "typewriter"
  }
}